{
    "name": "anis-ly/partners",
    "description": "The PHP SDK for the Anis Partner API — signed requests, verified responses, typed operations.",
    "type": "library",
    "license": "MIT",
    "keywords": ["anis", "libya", "partner-api", "http-signatures", "rfc9421", "sdk"],
    "homepage": "https://developers.anis.ly",
    "support": {
        "email": "support@anis.ly",
        "docs": "https://developers.anis.ly"
    },
    "authors": [
        {
            "name": "Aniscom for Technical Services (Anis)",
            "email": "support@anis.ly"
        }
    ],
    "require": {
        "php": "^8.2",
        "ext-hash": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "open-telemetry/api": "^1.1",
        "php-http/discovery": "^1.19",
        "psr/clock": "^1.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^2.0 || ^3.0",
        "psr/simple-cache": "^2.0 || ^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.9",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "Anis\\Partners\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Anis\\Partners\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        },
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G",
        "cs": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "check": ["@cs", "@analyse", "@test"]
    },
    "minimum-stability": "stable"
}
